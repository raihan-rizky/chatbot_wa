{
  "version": 2,
  "functions": {
    "app/main.py": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/privacy",
      "dest": "/public/privacy.html"
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}
